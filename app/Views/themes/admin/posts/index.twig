{% extends 'layouts/admin-base.twig' %}

{% block title %}Записи{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Записи</li>{% endblock %}

{% block content %}
<div class="filter-bar d-flex justify-content-between align-items-center flex-wrap">
    <form method="get" class="form-inline">
        <select name="status" class="form-control form-control-sm mr-2">
            <option value="">— любой статус —</option>
            {% for code, label in LABELS.post_status %}
                <option value="{{ code }}" {{ filter.status == code ? 'selected' : '' }}>{{ label }}</option>
            {% endfor %}
        </select>
        <select name="category_id" class="form-control form-control-sm mr-2">
            <option value="">— любая категория —</option>
            {% for c in categories %}
                <option value="{{ c.id }}" {{ filter.category_id == c.id ? 'selected' : '' }}>{{ c.name }}</option>
            {% endfor %}
        </select>
        <button class="btn btn-sm btn-primary"><i class="fas fa-filter mr-1"></i> Применить</button>
        {% if filter.status or filter.category_id %}
            <a href="/admin/posts" class="btn btn-sm btn-link text-muted">Сбросить</a>
        {% endif %}
    </form>

    <a href="/admin/posts/create" class="btn btn-success btn-sm">
        <i class="fas fa-plus mr-1"></i> Новая запись
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="thead-light">
                <tr>
                    <th style="width:60px">ID</th>
                    <th>Заголовок</th>
                    <th>Категория</th>
                    <th>Автор</th>
                    <th style="width:120px">Статус</th>
                    <th style="width:80px">Просм.</th>
                    <th style="width:130px">Опубликовано</th>
                    <th style="width:200px">Действия</th>
                </tr>
            </thead>
            <tbody>
                {% for p in posts %}
                    <tr>
                        <td class="text-muted">{{ p.id }}</td>
                        <td>
                            <strong>{{ p.title }}</strong><br>
                            <small class="text-muted">/{{ p.slug }}</small>
                        </td>
                        <td>{{ p.category_name|default('—') }}</td>
                        <td class="small">{{ p.author_name|default(p.author_username|default('—')) }}</td>
                        <td><span class="badge badge-{{ p.status }} p-1 px-2">{{ LABELS.post_status[p.status]|default(p.status) }}</span></td>
                        <td class="text-muted">{{ p.views }}</td>
                        <td class="text-muted small">{{ (p.published_at ?: p.created_at)|date('d.m.Y') }}</td>
                        <td class="table-actions">
                            <a href="/post/{{ p.slug }}" target="_blank" class="btn btn-xs btn-outline-secondary" title="Открыть на сайте"><i class="fas fa-eye"></i></a>
                            <a href="/admin/posts/{{ p.id }}/edit" class="btn btn-xs btn-primary"><i class="fas fa-edit"></i> Изменить</a>
                            <form action="/admin/posts/{{ p.id }}/delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Перевести запись в архив?');">
                                {{ csrf_field() }}
                                <button class="btn btn-xs btn-outline-danger"><i class="fas fa-archive"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" class="text-center text-muted p-3">Записей не найдено.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if pagination.total_pages > 1 %}
        <div class="card-footer clearfix">
            <ul class="pagination pagination-sm m-0 float-right">
                {% for page in 1..pagination.total_pages %}
                    {% set qs = [] %}
                    {% if filter.status %}{% set qs = qs|merge(['status=' ~ filter.status]) %}{% endif %}
                    {% if filter.category_id %}{% set qs = qs|merge(['category_id=' ~ filter.category_id]) %}{% endif %}
                    {% set qs = qs|merge(['page=' ~ page]) %}
                    <li class="page-item {{ page == pagination.current ? 'active' : '' }}">
                        <a class="page-link" href="?{{ qs|join('&') }}">{{ page }}</a>
                    </li>
                {% endfor %}
            </ul>
            <span class="text-muted small">Всего: {{ pagination.total }} записей</span>
        </div>
    {% endif %}
</div>
{% endblock %}
