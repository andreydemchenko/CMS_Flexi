{# боковая колонка #}
<aside class="p-l-10 p-rl-0-sr991 p-t-70">

    {# Категории #}
    <div class="p-b-60">
        <div class="how2 how2-cl4 flex-s-c">
            <h3 class="f1-m-2 cl3 tab01-title">Категории</h3>
        </div>

        <ul class="p-t-35">
            {% for cat in sidebar_categories|default([
                {name: 'Новости',     slug: 'news'},
                {name: 'Технологии',  slug: 'tech'},
                {name: 'Стиль жизни', slug: 'lifestyle'},
                {name: 'Путешествия', slug: 'travel'},
                {name: 'Видео',       slug: 'video'}
            ]) %}
                <li class="how-bor3 p-rl-4">
                    <a href="/category/{{ cat.slug }}"
                       class="dis-block f1-s-10 text-uppercase cl2 hov-cl10 trans-03 p-tb-13">
                        {{ cat.name }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>

    {# Популярные посты #}
    <div class="p-b-30">
        <div class="how2 how2-cl4 flex-s-c">
            <h3 class="f1-m-2 cl3 tab01-title">Популярное</h3>
        </div>

        <ul class="p-t-35">
            {% for post in popular_posts|default([]) %}
                <li class="flex-wr-sb-s p-b-30">
                    <a href="/post/{{ post.slug }}" class="size-w-10 wrap-pic-w hov1 trans-03">
                        <img src="{{ post.image|default('/assets/images/popular-post-04.jpg') }}" alt="IMG">
                    </a>

                    <div class="size-w-11">
                        <h6 class="p-b-4">
                            <a href="/post/{{ post.slug }}" class="f1-s-5 cl3 hov-cl10 trans-03">
                                {{ post.title }}
                            </a>
                        </h6>
                        <span class="cl8">
                            <a href="/category/{{ post.category_slug|default('news') }}" class="f1-s-6 cl8 hov-cl10 trans-03">
                                {{ post.category|default('Новости') }}
                            </a>
                            <span class="f1-s-3 m-rl-3">-</span>
                            <span class="f1-s-3">{{ post.date }}</span>
                        </span>
                    </div>
                </li>
            {% else %}
                <li class="f1-s-1 cl6">Пока ничего нет.</li>
            {% endfor %}
        </ul>
    </div>

    {# Теги #}
    <div>
        <div class="how2 how2-cl4 flex-s-c m-b-30">
            <h3 class="f1-m-2 cl3 tab01-title">Теги</h3>
        </div>

        <div class="flex-wr-s-s m-rl--5">
            {% for tag in tags|default(['php', 'mysql', 'mvc', 'twig', 'docker', 'web', 'дизайн']) %}
                <a href="/tag/{{ tag }}"
                   class="flex-c-c size-h-2 bo-1-rad-20 bocl12 f1-s-1 cl8 hov-btn2 trans-03 p-rl-20 p-tb-5 m-all-5">
                    {{ tag }}
                </a>
            {% endfor %}
        </div>
    </div>

</aside>
