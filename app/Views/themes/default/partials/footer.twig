{# подвал #}
<footer>
    <div class="bg2 p-t-40 p-b-25">
        <div class="container">
            <div class="row">

                <div class="col-lg-4 p-b-20">
                    <div class="size-h-3 flex-s-c">
                        <a href="/">
                            <img class="max-s-full" src="/assets/images/icons/logo-02.png" alt="LOGO">
                        </a>
                    </div>

                    <p class="f1-s-1 cl11 p-b-16">
                        CMS-Flexi — лёгкий блог-движок на PHP 8.2. Без фреймворков, всё прозрачно и под контролем.
                    </p>

                    <div class="p-t-15">
                        <a href="#" class="fs-18 cl11 hov-cl10 trans-03 m-r-8"><span class="fab fa-facebook-f"></span></a>
                        <a href="#" class="fs-18 cl11 hov-cl10 trans-03 m-r-8"><span class="fab fa-twitter"></span></a>
                        <a href="#" class="fs-18 cl11 hov-cl10 trans-03 m-r-8"><span class="fab fa-youtube"></span></a>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-4 p-b-20">
                    <div class="size-h-3 flex-s-c">
                        <h5 class="f1-m-7 cl0">Популярное</h5>
                    </div>

                    <ul>
                        {% for post in popular_posts|default([]) %}
                            <li class="flex-wr-sb-s p-b-20">
                                <a href="/post/{{ post.slug }}" class="size-w-4 wrap-pic-w hov1 trans-03">
                                    <img src="{{ post.image|default('/assets/images/popular-post-01.jpg') }}" alt="IMG">
                                </a>
                                <div class="size-w-5">
                                    <h6 class="p-b-5">
                                        <a href="/post/{{ post.slug }}" class="f1-s-5 cl11 hov-cl10 trans-03">
                                            {{ post.title }}
                                        </a>
                                    </h6>
                                    <span class="f1-s-3 cl6">{{ post.date }}</span>
                                </div>
                            </li>
                        {% else %}
                            <li class="f1-s-1 cl11">Пока ничего нет.</li>
                        {% endfor %}
                    </ul>
                </div>

                <div class="col-sm-6 col-lg-4 p-b-20">
                    <div class="size-h-3 flex-s-c">
                        <h5 class="f1-m-7 cl0">Категории</h5>
                    </div>

                    <ul class="m-t--12">
                        {% for cat in footer_categories|default([
                            {name: 'Новости',         slug: 'news',      count: 22},
                            {name: 'Технологии',      slug: 'tech',      count: 29},
                            {name: 'Стиль жизни',     slug: 'lifestyle', count: 28},
                            {name: 'Путешествия',     slug: 'travel',    count: 15}
                        ]) %}
                            <li class="how-bor1 p-rl-5 p-tb-10">
                                <a href="/category/{{ cat.slug }}" class="f1-s-5 cl11 hov-cl10 trans-03 p-tb-8">
                                    {{ cat.name }} ({{ cat.count }})
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

            </div>
        </div>
    </div>

    <div class="bg11">
        <div class="container size-h-4 flex-c-c p-tb-15">
            <span class="f1-s-1 cl0 txt-center">
                Copyright © {{ "now"|date("Y") }} CMS-Flexi
            </span>
        </div>
    </div>
</footer>
